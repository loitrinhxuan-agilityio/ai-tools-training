# Copy to .env (git-ignored) or export these in your shell.
# Local docker-compose credentials only; never reuse them elsewhere.
DATABASE_URL=postgres://banking:banking@localhost:5433/banking
TEST_DATABASE_URL=postgres://banking:banking@localhost:5433/banking_test
PORT=3000
# Bearer-token signing key, at least 32 characters. Generate a value locally
# (for example: openssl rand -base64 48). Never commit a real value.
JWT_SECRET=
